    "esbuild": "^0.21.5",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.0",
    "immer": "^11.1.3",
    "js-yaml": "^4.1.1",
    "jspdf": "^2.5.2",
    "just-bash": "^3.0.2",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.16.0",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.55.1",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "pyodide": "^0.29.3",
    "quickjs-wasi": "3.6.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
