{
  "name": "creatorweave-web",
  "version": "1.1.7",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-quickjs.mjs && node scripts/copy-pyodide.mjs && node scripts/prepare-pwa.mjs && next dev --hostname 0.0.0.0 --port 5173",
    "build": "node scripts/copy-quickjs.mjs && pnpm run prepare:assets && pnpm run prepare:pwa && next build",
    "prepare:pwa": "node scripts/prepare-pwa.mjs",
    "prepare:pyodide": "node scripts/copy-pyodide.mjs",
    "build:extension": "cd ../browser-extension && pnpm install && pnpm run build",
    "prepare:assets": "node scripts/prepare-static-assets.mjs",
    "pack:skills": "node scripts/pack-skills.mjs ../skill-store public/skills",
    "preview": "next start --hostname 0.0.0.0 --port 3000",
    "preview:prod": "pnpm build && pnpm preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"{app,agent,components,export,hooks,lib,opfs,pwa,python,router,services,shell,skills,sqlite,store,styles}/**/*.{ts,tsx,css}\" \"*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{app,agent,components,export,hooks,lib,opfs,pwa,python,router,services,shell,skills,sqlite,store,styles}/**/*.{ts,tsx,css}\" \"*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@creatorweave/config": "workspace:*",
    "@creatorweave/i18n": "workspace:*",
    "@creatorweave/shared": "workspace:*",
    "@creatorweave/skills-system": "workspace:*",
    "@creatorweave/ui": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.78.0",
    "@earendil-works/pi-ai": "^0.78.0",
    "@iconify/react": "^6.0.2",
    "@mcp-b/webmcp-polyfill": "4.0.0",
    "@mertdeveci55/univer-import-export": "^0.2.1",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "@tiptap/core": "^3.20.5",
    "@tiptap/extension-code": "^3.20.5",
    "@tiptap/extension-document": "^3.20.5",
    "@tiptap/extension-hard-break": "^3.20.5",
    "@tiptap/extension-history": "^3.20.5",
    "@tiptap/extension-mention": "^3.20.5",
    "@tiptap/extension-paragraph": "^3.20.5",
    "@tiptap/extension-text": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/suggestion": "^3.20.5",
    "@univerjs/preset-sheets-core": "^0.22.0",
    "@univerjs/preset-sheets-drawing": "^0.22.0",
    "@univerjs/presets": "^0.22.0",
    "@webcontainer/api": "^1.5.1",
    "@xyflow/react": "^12.10.2",
    "async-mutex": "^0.5.0",
    "best-effort-json-parser": "^1.4.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
