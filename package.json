{
  "name": "creatorweave",
  "version": "1.1.7",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "devDependencies": {
    "zx": "^8.8.5"
  },
  "resolutions": {
    "esbuild": "^0.21.5"
  },
  "scripts": {
    "test": "cd web && pnpm test",
    "check": "make lint && make typecheck && make test",
    "release": "node scripts/release.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "host": "cargo build --release --manifest-path browser-extension/native-host/Cargo.toml",
    "host:mac": "cargo build --release --manifest-path browser-extension/native-host/Cargo.toml",
    "host:win": "cargo build --release --target x86_64-pc-windows-gnu --manifest-path browser-extension/native-host/Cargo.toml",
    "host:test": "cargo test --manifest-path browser-extension/native-host/Cargo.toml",
    "host:check:win": "cargo check --target x86_64-pc-windows-gnu --manifest-path browser-extension/native-host/Cargo.toml",
    "host:install": "bash browser-extension/native-host/install.sh"
  }
}
