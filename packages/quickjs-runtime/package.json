    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "quickjs-wasi": "3.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.32",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
