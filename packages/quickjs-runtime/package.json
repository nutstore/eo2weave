{
  "name": "@creatorweave/quickjs-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Host-independent QuickJS execution with explicit JSON and async function bindings",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
