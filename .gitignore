# Rust
target/
# Cargo.lock: ignored for library crates (wasm); binary crates should commit it
Cargo.lock
!browser-extension/native-host/Cargo.lock
**/*.rs.bk
*.pdb

# WASM
wasm/pkg/
wasm/target/
web/public/wasm/*.wasm
web/public/wasm/*.js
web/public/wasm/*.json

# Node.js
node_modules/
web/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

