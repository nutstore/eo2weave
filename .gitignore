# Docs
# docs/ is the single source of truth; the App Router docs route reads it
# server-side at build time (web/lib/docs-server.ts) — no public/ copy exists.

# Node version
.nvmrc

# Specific doc files to ignore
docs/analysis-report.md
docs/design/design-system.md
docs/design/p0-performance-and-testing.md
docs/technical-debt-plan.md
.worktrees

# Browser extension (WXT)
browser-extension/.output/
browser-extension/.wxt/
.codegraph/

# Local design prototypes (HTML exploration files, not shippable assets)
prototypes/
# Native host installer build artifacts (generated, not for git)
browser-extension/native-host/installer/*.zip
browser-extension/native-host/installer/staging-*/
browser-extension/native-host/installer/scripts-pkg/
