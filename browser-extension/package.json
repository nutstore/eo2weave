{
  "name": "browser-extension",
  "version": "1.1.7",
  "description": "AI workspace in your browser sidebar, using the current page to help you read, write, analyze, and act with WebMCP authorization.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build:store": "CW_STORE_BUILD=1 wxt build",
    "zip:store": "CW_STORE_BUILD=1 wxt zip",
    "pack:release": "node scripts/pack-release.mjs",
    "build:firefox": "wxt build -b firefox",
    "watch": "wxt build --watch",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@creatorweave/quickjs-runtime": "workspace:*",
    "@creatorweave/shared": "workspace:*",
    "@mcp-b/webmcp-polyfill": "6.0.0",
    "@mozilla/readability": "^0.5.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.280",
    "@types/node": "^20.19.32",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.7.3",
    "wxt": "^0.19.0"
  },
  "keywords": [
    "chrome-extension",
    "agent",
    "web-search",
    "web-fetch"
  ],
  "license": "MIT"
}
